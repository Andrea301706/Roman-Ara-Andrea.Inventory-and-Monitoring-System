@page "/account/change-password"
@model ChangePasswordModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="avatar-card">

    <!-- Header -->
    <div class="avatar-header">

        <h2>Change Password</h2>

        <p>
            Update your account password
        </p>

    </div>

    <div class="avatar-section">

        <!-- Current Profile -->
        <div class="avatar-preview">

            <img src="@Model.ChangePassword.ProfileImage"
                 alt="Profile Image"
                 class="avatar-image" />

            <div class="user-name">
                @Model.ChangePassword.Username
            </div>

            <div class="username">
                @@@Model.ChangePassword.Username
            </div>

        </div>

        <!-- User Information -->
        <div class="user-information">

            <div class="information-title">
                Profile Information
            </div>

            <div class="information-row">

                <span class="information-label">
                    Username
                </span>

                <span class="information-value">
                    @Model.ChangePassword.Username
                </span>

            </div>

            <div class="information-row">

                <span class="information-label">
                    Account
                </span>

                <span class="information-value">
                    Change Password
                </span>

            </div>

        </div>

        <hr class="divider" />

        <!-- Password Section -->

        <div class="section-title">
            Change Your Password
        </div>

        <div class="section-description">
            Enter your current password and create a new
            password for your account.
        </div>

        <form method="post">

            <!-- Validation Summary -->

            <div asp-validation-summary="All"
                 class="text-danger validation-summary">
            </div>

            <!-- Current Password -->

            <div class="password-field">

                <label asp-for="ChangePassword.CurrentPassword"
                       class="file-label">
                    Current Password
                </label>

                <input asp-for="ChangePassword.CurrentPassword"
                       type="password"
                       class="form-control"
                       placeholder="Enter your current password" />

                <span asp-validation-for="ChangePassword.CurrentPassword"
                      class="text-danger validation-message">
                </span>

            </div>

            <!-- New Password -->

            <div class="password-field">

                <label asp-for="ChangePassword.NewPassword"
                       class="file-label">
                    New Password
                </label>

                <input asp-for="ChangePassword.NewPassword"
                       type="password"
                       class="form-control"
                       placeholder="Enter your new password" />

                <small class="file-help">
                    Minimum 8 characters with at least one uppercase
                    letter, one lowercase letter, one number,
                    and one special character.
                </small>

                <span asp-validation-for="ChangePassword.NewPassword"
                      class="text-danger validation-message">
                </span>

            </div>

            <!-- Confirm New Password -->

            <div class="password-field">

                <label asp-for="ChangePassword.ConfirmNewPassword"
                       class="file-label">
                    Confirm New Password
                </label>

                <input asp-for="ChangePassword.ConfirmNewPassword"
                       type="password"
                       class="form-control"
                       placeholder="Confirm your new password" />

                <span asp-validation-for="ChangePassword.ConfirmNewPassword"
                      class="text-danger validation-message">
                </span>

            </div>

            <!-- Buttons -->

            <div class="button-container">

                <a asp-page="/Account/Profile"
                   class="avatar-button cancel-button">
                    Cancel
                </a>

                <button type="submit"
                        class="avatar-button save-button">
                    Change Password
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}