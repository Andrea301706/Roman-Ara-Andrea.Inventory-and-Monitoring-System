@page "/account/change-password"
@model ChangePasswordModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="change-password-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <div class="page-eyebrow">
                ACCOUNT SECURITY
            </div>

            <h1>
                Change Password
            </h1>

            <p>
                Update your password to keep your account secure.
            </p>
        </div>

        <div class="header-icon">
            <i class="bi bi-shield-lock"></i>
        </div>
    </div>


    <!-- MAIN CARD -->
    <div class="password-card">

        <!-- CARD HEADER -->
        <div class="password-card-header">

            <div class="security-icon">
                <i class="bi bi-lock-fill"></i>
            </div>

            <div>
                <h2>Change Your Password</h2>

                <p>
                    Enter your current password and create a new password
                    for your account.
                </p>
            </div>

        </div>


        <!-- USER INFO -->
        <div class="account-info">

            <div class="account-avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <div class="account-details">

                <strong>
                    @Model.ChangePassword.Username
                </strong>

                <span>
                    Account Password
                </span>

            </div>

        </div>


        <div class="card-divider"></div>


        <!-- FORM -->
        <form method="post">

            <!-- VALIDATION -->
            <div asp-validation-summary="All"
                 class="validation-summary">
            </div>


            <!-- CURRENT PASSWORD -->
            <div class="password-group">

                <label asp-for="ChangePassword.CurrentPassword">
                    Current Password
                </label>

                <div class="password-input">

                    <i class="bi bi-lock"></i>

                    <input asp-for="ChangePassword.CurrentPassword"
                           type="password"
                           id="currentPassword"
                           placeholder="Enter your current password" />

                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword('currentPassword', this)"
                            aria-label="Show password">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

                <span asp-validation-for="ChangePassword.CurrentPassword"
                      class="field-error">
                </span>

            </div>


            <!-- NEW PASSWORD -->
            <div class="password-group">

                <label asp-for="ChangePassword.NewPassword">
                    New Password
                </label>

                <div class="password-input">

                    <i class="bi bi-key"></i>

                    <input asp-for="ChangePassword.NewPassword"
                           type="password"
                           id="newPassword"
                           placeholder="Enter your new password" />

                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword('newPassword', this)"
                            aria-label="Show password">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

                <span asp-validation-for="ChangePassword.NewPassword"
                      class="field-error">
                </span>


                <!-- PASSWORD REQUIREMENTS -->
                <div class="password-help">

                    <div class="help-title">
                        <i class="bi bi-info-circle"></i>
                        Password requirements
                    </div>

                    <ul>
                        <li>At least 8 characters</li>
                        <li>One uppercase letter</li>
                        <li>One lowercase letter</li>
                        <li>One number</li>
                        <li>One special character</li>
                    </ul>

                </div>

            </div>


            <!-- CONFIRM PASSWORD -->
            <div class="password-group">

                <label asp-for="ChangePassword.ConfirmNewPassword">
                    Confirm New Password
                </label>

                <div class="password-input">

                    <i class="bi bi-shield-check"></i>

                    <input asp-for="ChangePassword.ConfirmNewPassword"
                           type="password"
                           id="confirmPassword"
                           placeholder="Confirm your new password" />

                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword('confirmPassword', this)"
                            aria-label="Show password">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

                <span asp-validation-for="ChangePassword.ConfirmNewPassword"
                      class="field-error">
                </span>

            </div>


            <!-- BUTTONS -->
            <div class="form-actions">

                <a asp-page="/Account/Profile"
                   class="cancel-button">

                    <i class="bi bi-arrow-left"></i>

                    Cancel

                </a>


                <button type="submit"
                        class="change-button">

                    <i class="bi bi-check2-circle"></i>

                    Change Password

                </button>

            </div>

        </form>

    </div>


    <!-- SECURITY NOTE -->
    <div class="security-note">

        <div class="note-icon">
            <i class="bi bi-shield-check"></i>
        </div>

        <div>
            <strong>Your account security matters</strong>

            <p>
                Use a password that you do not use on other websites or accounts.
            </p>
        </div>

    </div>

</div>


<style>

    /* ================================
       PAGE
    ================================= */

    .change-password-page {
        padding: 34px 42px 50px;
        background: #fdf5f8;
        min-height: calc(100vh - 75px);
        color: #42172e;
    }


    /* ================================
       HEADER
    ================================= */

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
    }

    .page-eyebrow {
        color: #a51d5b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 7px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 800;
        color: #42172e;
    }

    .page-header p {
        margin: 7px 0 0;
        color: #8b7180;
        font-size: 15px;
    }

    .header-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #8f174f, #d84b88);
        color: white;
        font-size: 25px;
        box-shadow: 0 10px 25px rgba(165, 29, 91, .20);
    }


    /* ================================
       CARD
    ================================= */

    .password-card {
        max-width: 900px;
        background: white;
        border: 1px solid #f3dce6;
        border-radius: 22px;
        padding: 30px;
        box-shadow: 0 10px 35px rgba(107, 25, 70, .10);
    }


    /* ================================
       CARD HEADER
    ================================= */

    .password-card-header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 25px;
    }

    .security-icon {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        border-radius: 17px;
        background: #fce8f1;
        color: #a51d5b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .password-card-header h2 {
        margin: 0 0 5px;
        font-size: 21px;
        font-weight: 800;
        color: #42172e;
    }

    .password-card-header p {
        margin: 0;
        color: #8b7180;
        font-size: 14px;
    }


    /* ================================
       ACCOUNT INFO
    ================================= */

    .account-info {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 17px 18px;
        background: #fdf7fa;
        border: 1px solid #f3dce6;
        border-radius: 15px;
    }

    .account-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, #8f174f, #d84b88);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .account-details {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .account-details strong {
        color: #42172e;
        font-size: 15px;
    }

    .account-details span {
        color: #9a7d8c;
        font-size: 13px;
    }


    /* ================================
       DIVIDER
    ================================= */

    .card-divider {
        height: 1px;
        background: #f3dce6;
        margin: 26px 0;
    }


    /* ================================
       FORM
    ================================= */

    .password-group {
        margin-bottom: 22px;
    }

    .password-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 700;
        color: #4a1830;
    }

    .password-input {
        position: relative;
        display: flex;
        align-items: center;
    }

    .password-input > i {
        position: absolute;
        left: 16px;
        color: #a51d5b;
        font-size: 17px;
        z-index: 2;
    }

    .password-input input {
        width: 100%;
        height: 52px;
        border: 1px solid #ead6df;
        border-radius: 12px;
        padding: 0 50px 0 46px;
        outline: none;
        color: #42172e;
        background: white;
        font-size: 14px;
        transition: .2s ease;
    }

    .password-input input::placeholder {
        color: #b49aa7;
    }

    .password-input input:focus {
        border-color: #c93673;
        box-shadow: 0 0 0 4px rgba(201, 54, 115, .10);
    }


    /* ================================
       PASSWORD TOGGLE
    ================================= */

    .password-toggle {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 9px;
        background: transparent;
        color: #9a7d8c;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .password-toggle:hover {
        background: #fce8f1;
        color: #a51d5b;
    }


    /* ================================
       PASSWORD HELP
    ================================= */

    .password-help {
        margin-top: 10px;
        padding: 13px 15px;
        border-radius: 11px;
        background: #fdf7fa;
        border: 1px solid #f3dce6;
    }

    .help-title {
        color: #a51d5b;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .help-title i {
        margin-right: 5px;
    }

    .password-help ul {
        margin: 0;
        padding-left: 20px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 4px;
        color: #8b7180;
        font-size: 12px;
    }


    /* ================================
       VALIDATION
    ================================= */

    .validation-summary {
        margin-bottom: 20px;
        padding: 12px 15px;
        border-radius: 11px;
        background: #fff0f3;
        border: 1px solid #f3c7d5;
        color: #a51d5b;
        font-size: 13px;
    }

    .validation-summary:empty {
        display: none;
    }

    .field-error {
        display: block;
        margin-top: 6px;
        color: #c62858;
        font-size: 12px;
    }


    /* ================================
       BUTTONS
    ================================= */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #f3dce6;
    }

    .cancel-button,
    .change-button {
        min-height: 46px;
        padding: 0 20px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }

    .cancel-button {
        color: #6f5865;
        background: white;
        border: 1px solid #ead6df;
    }

    .cancel-button:hover {
        background: #fdf5f8;
        color: #42172e;
    }

    .change-button {
        border: 0;
        color: white;
        background: linear-gradient(135deg, #8f174f, #d84b88);
        box-shadow: 0 8px 20px rgba(165, 29, 91, .20);
    }

    .change-button:hover {
        transform: translateY(-1px);
        box-shadow: 0 11px 24px rgba(165, 29, 91, .28);
    }


    /* ================================
       SECURITY NOTE
    ================================= */

    .security-note {
        max-width: 900px;
        margin-top: 18px;
        padding: 17px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        background: #fce8f1;
        border: 1px solid #f3dce6;
        border-radius: 15px;
    }

    .note-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 11px;
        background: white;
        color: #a51d5b;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .security-note strong {
        display: block;
        color: #42172e;
        font-size: 13px;
        margin-bottom: 2px;
    }

    .security-note p {
        margin: 0;
        color: #8b7180;
        font-size: 12px;
    }


    /* ================================
       RESPONSIVE
    ================================= */

    @@media (max-width: 768px) {

        .change-password-page {
            padding: 25px 18px 40px;
        }

        .page-header h1 {
            font-size: 27px;
        }

        .password-card {
            padding: 22px;
        }

        .password-card-header {
            align-items: flex-start;
        }

        .password-help ul {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .cancel-button,
        .change-button {
            width: 100%;
        }

    }

</style>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function togglePassword(inputId, button) {

            const input = document.getElementById(inputId);
            const icon = button.querySelector("i");

            if (input.type === "password") {

                input.type = "text";

                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");

                button.setAttribute("aria-label", "Hide password");

            }
            else {

                input.type = "password";

                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");

                button.setAttribute("aria-label", "Show password");

            }

        }

    </script>
}