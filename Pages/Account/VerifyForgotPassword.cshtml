@page "/account/verify-forgot-password"
@model Roman_Ara_Andrea.Inventory_and_Monitoring_System.Pages.Account.VerifyForgotPasswordModel

@{
    ViewData["Title"] = "Reset Password";
}

<style>
    body {
        background: #fdf5f8;
    }

    .reset-page {
        min-height: calc(100vh - 80px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .reset-card {
        width: 100%;
        max-width: 520px;
        background: white;
        border: 1px solid #f3dce6;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(107, 25, 70, 0.10);
    }

    .reset-header {
        background: linear-gradient(135deg, #8f174f, #d84b88);
        color: white;
        padding: 30px 35px;
    }

    .reset-header h2 {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
    }

    .reset-header p {
        margin: 7px 0 0;
        font-size: 14px;
        opacity: .9;
    }

    .reset-content {
        padding: 35px;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #4a1830;
        font-weight: 600;
        font-size: 14px;
    }

    .password-wrapper {
        position: relative;
    }

    .form-control {
        width: 100%;
        height: 48px;
        padding: 10px 45px 10px 15px;
        border: 1px solid #e8ccd9;
        border-radius: 10px;
        background: #fffafb;
        box-sizing: border-box;
    }

    .form-control:focus {
        border-color: #a51d5b;
        box-shadow: 0 0 0 3px rgba(165, 29, 91, .10);
        outline: none;
    }

    .password-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #9a7d8c;
        cursor: pointer;
    }

    .password-toggle:hover {
        color: #a51d5b;
    }

    .reset-error {
        background: #fff0f4;
        border: 1px solid #f2c8d7;
        border-radius: 10px;
        padding: 13px 15px;
        margin-bottom: 20px;
        color: #a51d5b;
        font-size: 14px;
    }

    .validation-message {
        display: block;
        margin-top: 6px;
        font-size: 13px;
    }

    .button-row {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .btn-reset,
    .btn-back {
        flex: 1;
        height: 46px;
        border-radius: 10px;
        font-weight: 600;
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-reset {
        border: none;
        background: #a51d5b;
        color: white;
    }

    .btn-reset:hover {
        background: #8f174f;
        color: white;
    }

    .btn-back {
        background: #fce8f1;
        color: #a51d5b;
        border: 1px solid #f1d2df;
    }

    .btn-back:hover {
        background: #f7dce8;
        color: #8f174f;
    }

    .security-note {
        text-align: center;
        margin-top: 22px;
        font-size: 12px;
        color: #9a7d8c;
    }

    @@media (max-width: 576px) {

        .reset-page {
            padding: 20px 12px;
        }

        .reset-header {
            padding: 25px;
        }

        .reset-header h2 {
            font-size: 23px;
        }

        .reset-content {
            padding: 28px 22px;
        }

        .button-row {
            flex-direction: column;
        }
    }
</style>


<div class="reset-page">

    <div class="reset-card">

        <!-- Header -->
        <div class="reset-header">
            <h2>Reset Password</h2>
            <p>Create a new password for your account.</p>
        </div>


        <div class="reset-content">

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="reset-error">
                    @Model.ErrorMessage
                </div>
            }
            else
            {
                <form method="post">

                    <!-- Hidden values -->
                    <input asp-for="Token" type="hidden" />
                    <input asp-for="UserId" type="hidden" />

                    <!-- New Password -->
                    <div class="form-group">

                        <label asp-for="NewPassword"
                               class="form-label">
                            New Password
                        </label>

                        <div class="password-wrapper">

                            <input asp-for="NewPassword"
                                   id="newPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter your new password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('newPassword', 'newPasswordIcon')">

                                <i id="newPasswordIcon"
                                   class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword"
                              class="text-danger validation-message"></span>

                    </div>


                    <!-- Confirm Password -->
                    <div class="form-group">

                        <label asp-for="ConfirmPassword"
                               class="form-label">
                            Confirm Password
                        </label>

                        <div class="password-wrapper">

                            <input asp-for="ConfirmPassword"
                                   id="confirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Confirm your new password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('confirmPassword', 'confirmPasswordIcon')">

                                <i id="confirmPasswordIcon"
                                   class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger validation-message"></span>

                    </div>


                    <!-- Buttons -->
                    <div class="button-row">

                        <a asp-page="/Account/Login"
                           class="btn-back">
                            Back to Login
                        </a>

                        <button type="submit"
                                class="btn-reset">
                            Reset Password
                        </button>

                    </div>

                    <div class="security-note">
                        Make sure your new password is strong and secure.
                    </div>

                </form>
            }

        </div>

    </div>

</div>


<script>
    function togglePassword(inputId, iconId) {

        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);

        if (input.type === "password") {

            input.type = "text";

            icon.classList.remove("bi-eye");
            icon.classList.add("bi-eye-slash");

        } else {

            input.type = "password";

            icon.classList.remove("bi-eye-slash");
            icon.classList.add("bi-eye");

        }
    }
</script>