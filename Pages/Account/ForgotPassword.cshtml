@page "/account/forgot-password"

@model Roman_Ara_Andrea.Inventory_and_Monitoring_System.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="text-center p-4 invitation-header">

                    <div class="forgot-icon mx-auto mb-3">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>

                    <h2 class="fw-bold mb-2">Forgot Password?</h2>

                    <p class="mb-0 text-muted">
                        No worries. Enter your email address and we'll
                        help you reset your password.
                    </p>

                </div>

                <!-- Body -->
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h5 class="fw-semibold">Reset Your Password</h5>

                        <p class="small text-muted mb-0">
                            Enter the email address associated with your account.
                        </p>
                    </div>

                    <!-- Success Message -->
                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="alert alert-success d-flex align-items-start rounded-3 mb-4"
                             role="alert">

                            <i class="bi bi-check-circle-fill me-2 mt-1"></i>

                            <div>
                                @Model.Message
                            </div>

                        </div>
                    }

                    <form method="post">

                        <!-- Email -->
                        <div class="mb-4">

                            <label asp-for="EmailAddress"
                                   class="form-label fw-semibold">
                                Email Address
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-white">
                                    <i class="bi bi-envelope-fill text-muted"></i>
                                </span>

                                <input asp-for="EmailAddress"
                                       class="form-control"
                                       placeholder="Enter your email address"
                                       autocomplete="email" />

                            </div>

                            <span asp-validation-for="EmailAddress"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- Submit -->
                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-reset btn-lg rounded-3 fw-semibold">

                                <i class="bi bi-send-fill me-2"></i>
                                Send Reset Link

                            </button>

                        </div>

                    </form>

                    <!-- Back to Login -->
                    <div class="text-center mt-4">

                        <a asp-page="/Account/Login"
                           class="fw-semibold login-link">

                            <i class="bi bi-arrow-left me-1"></i>
                            Back to Sign In

                        </a>

                    </div>

                </div>

                <!-- Footer -->
                <div class="card-footer bg-white border-0 text-center pb-4">

                    <small class="text-muted">

                        <i class="bi bi-shield-check me-1"></i>

                        Your account information is securely protected.

                    </small>

                </div>

            </div>

            <!-- Copyright -->
            <div class="text-center mt-4">

                <small class="text-muted">
                    © @DateTime.Now.Year Inventory & Monitoring System
                </small>

            </div>

        </div>
    </div>
</div>

<style>

    body {
        background-color: #f8f9fa;
    }

    .invitation-header {
        background: linear-gradient(135deg, #fff0f6, #ffffff);
        border-bottom: 1px solid #f1f1f1;
    }

    .forgot-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fce4ec;
        color: #d63384;
        font-size: 32px;
    }

    .form-control,
    .input-group-text,
    .btn {
        min-height: 48px;
    }

    .form-control:focus {
        border-color: #d63384;
        box-shadow: 0 0 0 0.2rem rgba(214, 51, 132, 0.15);
    }

    .btn-reset {
        background: linear-gradient(135deg, #d63384, #c2185b);
        border: none;
        color: white;
        transition: all 0.2s ease;
    }

    .btn-reset:hover {
        background: linear-gradient(135deg, #c2185b, #ad1457);
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 6px 15px rgba(214, 51, 132, 0.25);
    }

    .login-link {
        color: #d63384;
        text-decoration: none;
    }

    .login-link:hover {
        color: #ad1457;
        text-decoration: underline;
    }

    .input-group .form-control {
        border-left: 0;
    }

    .input-group-text {
        border-right: 0;
    }

    @@media (max-width: 576px) {

        .card-body {
            padding: 1.5rem !important;
        }

        .forgot-icon {
            width: 64px;
            height: 64px;
            font-size: 28px;
        }

    }

</style>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
