@page "{id:int}"
@model Roman_Ara_Andrea.Inventory_and_Monitoring_System.Pages.Admin.Products.DetailsModel

@{
    ViewData["Title"] = "Product Details";

    var isLowStock =
        Model.Product.CurrentStock <= Model.Product.ReorderLevel;
}

<div class="products-page">

    <!-- HEADER -->
    <div class="products-header">

        <div>
            <h1>Product Details</h1>
            <p>View complete information about this inventory product.</p>
        </div>

        <div class="d-flex gap-2">

            <a asp-page="./Index"
               class="btn btn-light">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

            <a asp-page="./Edit"
               asp-route-id="@Model.Product.Id"
               class="btn btn-pink">
                <i class="bi bi-pencil"></i>
                Edit Product
            </a>

        </div>

    </div>


    <!-- PRODUCT DETAILS CARD -->
    <div class="product-details-card">

        <!-- PRODUCT HEADER -->
        <div class="product-details-header">

            <div class="details-product-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <div class="details-product-title">

                <h2>
                    @Model.Product.Name
                </h2>

                <span>
                    Product Code:
                    <strong>@Model.Product.ProductCode</strong>
                </span>

            </div>

            <div class="details-status">

                @if (isLowStock)
                {
                    <span class="product-status low">
                        <i class="bi bi-exclamation-circle"></i>
                        Low Stock
                    </span>
                }
                else
                {
                    <span class="product-status good">
                        <i class="bi bi-check-circle"></i>
                        In Stock
                    </span>
                }

            </div>

        </div>


        <!-- INFORMATION -->
        <div class="product-details-body">

            <h5 class="details-section-title">
                <i class="bi bi-info-circle"></i>
                Product Information
            </h5>


            <div class="row g-4">

                <!-- ID -->
                <div class="col-md-6">

                    <div class="detail-item">

                        <span class="detail-label">
                            Product ID
                        </span>

                        <strong>
                            #@Model.Product.Id
                        </strong>

                    </div>

                </div>


                <!-- PRODUCT CODE -->
                <div class="col-md-6">

                    <div class="detail-item">

                        <span class="detail-label">
                            Product Code
                        </span>

                        <strong>
                            @Model.Product.ProductCode
                        </strong>

                    </div>

                </div>


                <!-- PRODUCT NAME -->
                <div class="col-md-6">

                    <div class="detail-item">

                        <span class="detail-label">
                            Product Name
                        </span>

                        <strong>
                            @Model.Product.Name
                        </strong>

                    </div>

                </div>


                <!-- UNIT PRICE -->
                <div class="col-md-6">

                    <div class="detail-item">

                        <span class="detail-label">
                            Unit Price
                        </span>

                        <strong class="detail-price">
                            ₱@Model.Product.UnitPrice.ToString("N2")
                        </strong>

                    </div>

                </div>

            </div>


            <!-- INVENTORY INFORMATION -->
            <h5 class="details-section-title inventory-title">
                <i class="bi bi-boxes"></i>
                Inventory Information
            </h5>


            <div class="row g-4">

                <!-- CURRENT STOCK -->
                <div class="col-md-4">

                    <div class="inventory-detail-box">

                        <div class="inventory-detail-icon stock">
                            <i class="bi bi-boxes"></i>
                        </div>

                        <div>
                            <span>Current Stock</span>

                            <strong>
                                @Model.Product.CurrentStock
                            </strong>

                            <small>
                                Items available
                            </small>
                        </div>

                    </div>

                </div>


                <!-- REORDER LEVEL -->
                <div class="col-md-4">

                    <div class="inventory-detail-box">

                        <div class="inventory-detail-icon reorder">
                            <i class="bi bi-arrow-repeat"></i>
                        </div>

                        <div>
                            <span>Reorder Level</span>

                            <strong>
                                @Model.Product.ReorderLevel
                            </strong>

                            <small>
                                Minimum stock level
                            </small>
                        </div>

                    </div>

                </div>


                <!-- STATUS -->
                <div class="col-md-4">

                    <div class="inventory-detail-box">

                        <div class="inventory-detail-icon status">
                            @if (isLowStock)
                            {
                                <i class="bi bi-exclamation-triangle"></i>
                            }
                            else
                            {
                                <i class="bi bi-check-circle"></i>
                            }
                        </div>

                        <div>

                            <span>Status</span>

                            @if (isLowStock)
                            {
                                <strong class="text-warning">
                                    Low Stock
                                </strong>

                                <small>
                                    Restocking recommended
                                </small>
                            }
                            else
                            {
                                <strong class="text-success">
                                    In Stock
                                </strong>

                                <small>
                                    Stock level is healthy
                                </small>
                            }

                        </div>

                    </div>

                </div>

            </div>


            <!-- ACTIONS -->
            <div class="details-footer">

                <a asp-page="./Index"
                   class="btn btn-light">

                    <i class="bi bi-arrow-left"></i>
                    Back to Products

                </a>

                <a asp-page="./Edit"
                   asp-route-id="@Model.Product.Id"
                   class="btn btn-pink">

                    <i class="bi bi-pencil"></i>
                    Edit Product

                </a>

            </div>

        </div>

    </div>

</div>