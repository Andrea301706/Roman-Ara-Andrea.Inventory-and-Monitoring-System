@page
@model Roman_Ara_Andrea.Inventory_and_Monitoring_System.Pages.Admin.Products.IndexModel

@{
    ViewData["Title"] = "Products";
}

<div class="products-page">

    <!-- HEADER -->
    <div class="products-header">
        <div>
            <div class="dashboard-eyebrow">
                <i class="bi bi-box-seam"></i>
                Inventory Management
            </div>

            <h1>Products</h1>

            <p>Manage and monitor your inventory products.</p>
        </div>

        <a asp-page="/Admin/Products/Create" class="btn btn-pink">
            <i class="bi bi-plus-lg"></i>
            Add Product
        </a>
    </div>


    <!-- SUMMARY CARDS -->
    <div class="products-summary">

        <div class="product-summary-card">
            <div class="summary-icon pink">
                <i class="bi bi-box-seam"></i>
            </div>

            <div>
                <span>Total Products</span>
                <h2>@Model.Products.Count</h2>
                <small>Products in inventory</small>
            </div>
        </div>


        <div class="product-summary-card">
            <div class="summary-icon green">
                <i class="bi bi-boxes"></i>
            </div>

            <div>
                <span>Total Stock</span>
                <h2>@Model.Products.Sum(p => p.CurrentStock)</h2>
                <small>Items currently available</small>
            </div>
        </div>


        <div class="product-summary-card">
            <div class="summary-icon orange">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div>
                <span>Low Stock</span>
                <h2>
                    @Model.Products.Count(
                        p => p.CurrentStock <= p.ReorderLevel
                    )
                </h2>
                <small>Products need attention</small>
            </div>
        </div>

    </div>


    <!-- PRODUCT INVENTORY -->
    <div class="products-card">

        <div class="products-card-header">

            <div>
                <div class="dashboard-eyebrow">
                    Inventory List
                </div>

                <h4>
                    <i class="bi bi-box-seam"></i>
                    Product Inventory
                </h4>

                <p>View and manage all products in your inventory.</p>
            </div>


            <div class="product-search">
                <i class="bi bi-search"></i>

                <input type="text"
                       id="productSearch"
                       placeholder="Search products..." />
            </div>

        </div>


        <div class="table-responsive">

            <table class="table products-table" id="productsTable">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Product Code</th>
                        <th>Product</th>
                        <th>Unit Price</th>
                        <th>Stock</th>
                        <th>Reorder Level</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>


                <tbody>

                    @if (Model.Products.Any())
                    {
                        foreach (var product in Model.Products)
                        {
                            var lowStock =
                                product.CurrentStock <= product.ReorderLevel;

                            <tr>

                                <td>
                                    <span class="product-id">
                                        @product.Id
                                    </span>
                                </td>


                                <td>
                                    <span class="product-code-badge">
                                        @product.ProductCode
                                    </span>
                                </td>


                                <td>
                                    <div class="product-info">

                                        <div class="product-avatar">
                                            <i class="bi bi-box"></i>
                                        </div>

                                        <div>
                                            <strong>@product.Name</strong>
                                            <small>Inventory product</small>
                                        </div>

                                    </div>
                                </td>


                                <td>
                                    <strong class="product-price">
                                        ₱@product.UnitPrice.ToString("N2")
                                    </strong>
                                </td>


                                <td>
                                    <strong class="@(lowStock ? "stock-low" : "stock-good")">
                                        @product.CurrentStock
                                    </strong>
                                </td>


                                <td>
                                    <span class="reorder-level">
                                        @product.ReorderLevel
                                    </span>
                                </td>


                                <td>
                                    @if (lowStock)
                                    {
                                        <span class="product-status low">
                                            <i class="bi bi-exclamation-circle"></i>
                                            Low Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="product-status good">
                                            <i class="bi bi-check-circle"></i>
                                            In Stock
                                        </span>
                                    }
                                </td>


                                <td>
                                    <div class="product-actions">

                                        <a asp-page="./Details"
                                           asp-route-id="@product.Id"
                                           class="action-button view"
                                           title="View Product">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-page="./Edit"
                                           asp-route-id="@product.Id"
                                           class="action-button edit"
                                           title="Edit Product">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-page="./Delete"
                                           asp-route-id="@product.Id"
                                           class="action-button delete"
                                           title="Delete Product">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">

                                <div class="empty-products">

                                    <div class="empty-icon">
                                        <i class="bi bi-box-seam"></i>
                                    </div>

                                    <h5>No Products Found</h5>

                                    <p>
                                        There are currently no products
                                        in your inventory.
                                    </p>

                                    <a asp-page="/Admin/Products/Create"
                                       class="btn btn-pink">
                                        <i class="bi bi-plus-lg"></i>
                                        Add Product
                                    </a>

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts {

    <script>
        const searchInput = document.getElementById("productSearch");

        if (searchInput) {
            searchInput.addEventListener("keyup", function () {

                const searchValue = this.value.toLowerCase();

                const rows = document.querySelectorAll(
                    "#productsTable tbody tr"
                );

                rows.forEach(function (row) {

                    const text = row.textContent.toLowerCase();

                    row.style.display =
                        text.includes(searchValue) ? "" : "none";

                });
            });
        }
    </script>
}